{
  "_readme": "NonoClaw 最小可运行配置示例（v0.23+）。安装后复制到 ~/.nonoclaw/settings.json 并把 RANDOM_*_REPLACE_ME 替换为真实密钥。env 中声明的变量可在 models[].apiKey 里以 $VAR 引用。mcpServers/permissions/providerBilling 按需增删。",
  "autoCompact": true,
  "compactThreshold": 150000,
  "compactMaxTokens": 8192,
  "compactModel": "deepseek-v4-pro",
  "elevenlabsApiKey": "RANDOM_ELEVENLABS_KEY_REPLACE_ME",
  "env": {
    "DEEPSEEK_API_KEY": "RANDOM_DEEPSEEK_KEY_REPLACE_ME",
    "BRAVE_API_KEY": "RANDOM_BRAVE_KEY_REPLACE_ME",
    "FIRECRAWL_API_KEY": "RANDOM_FIRECRAWL_KEY_REPLACE_ME"
  },
  "models": [
    {
      "name": "deepseek-v4-flash-vision-exp",
      "label": "DeepSeek V4 Flash Vision Exp",
      "baseUrl": "https://api.deepseek.com",
      "apiKey": "$DEEPSEEK_API_KEY",
      "role": ["main", "doc"],
      "apiFormat": "openai",
      "contextWindow": 128000,
      "maxTokens": 8192,
      "billingProvider": "deepseek"
    },
    {
      "name": "deepseek-v4-pro",
      "label": "DeepSeek V4 Pro",
      "baseUrl": "https://api.deepseek.com/anthropic",
      "apiKey": "$DEEPSEEK_API_KEY",
      "role": ["main", "compact"],
      "apiFormat": "anthropic",
      "contextWindow": 1048576,
      "maxTokens": 8192,
      "charsPerToken": 3,
      "billingProvider": "deepseek",
      "default": true
    },
    {
      "name": "deepseek-v4-flash",
      "label": "DeepSeek V4 Flash",
      "baseUrl": "https://api.deepseek.com/anthropic",
      "apiKey": "$DEEPSEEK_API_KEY",
      "role": ["main"],
      "apiFormat": "anthropic",
      "contextWindow": 1048576,
      "maxTokens": 8192,
      "charsPerToken": 3,
      "billingProvider": "deepseek"
    }
  ],
  "docModel": {
    "provider": "baidu_unlimited",
    "model": "unlimited-ocr",
    "baseUrl": "https://aip.baidubce.com",
    "apiKey": "RANDOM_DOCMODEL_API_KEY_REPLACE_ME",
    "apiSecret": "RANDOM_DOCMODEL_API_SECRET_REPLACE_ME"
  },
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "playwright-mcp"]
    },
    "paper-search-mcp": {
      "command": "paper-search-mcp",
      "args": [],
      "env": {
        "ARXIV_CONTACT_EMAIL": "RANDOM_EMAIL_REPLACE_ME"
      }
    },
    "crawl4ai": {
      "command": "python3",
      "args": ["~/.nonoclaw/mcp-proxies/crawl4ai-proxy.py"]
    }
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": []
  },
  "providerBilling": {
    "providers": {
      "deepseek": {
        "balanceUrl": "https://api.deepseek.com/user/balance",
        "apiKey": "$DEEPSEEK_API_KEY"
      }
    }
  }
}
